#VRML_SIM R2025a utf8

WorldInfo {
  title "TEMMS Webots camera classification"
  info [
    "A camera views local photographs; this is classification, not robot navigation."
  ]
  basicTimeStep 32
  coordinateSystem "ENU"
  randomSeed 0
}
Viewpoint {
  orientation -0.158034454 0.351918050 0.922593517 0.905971972
  position -3.8 -3.6 2.6
  ambientOcclusionRadius 0
  bloomThreshold -1
}
Background {
  skyColor [ 0.025 0.035 0.055 ]
}
DirectionalLight {
  direction 0.3 0.5 -1
  intensity 0.8
}
Pose {
  translation -0.6 0 -0.04
  children [
    Shape {
      appearance Appearance {
        material Material { diffuseColor 0.065 0.09 0.13 }
      }
      geometry Box { size 4.4 3.8 0.08 }
    }
  ]
}
Pose {
  translation 0.06 0 0.035
  children [
    Shape {
      appearance DEF EXHIBIT_FINISH Appearance {
        material Material { diffuseColor 0.12 0.18 0.24 }
      }
      geometry Box { size 0.65 1.45 0.07 }
    }
    Pose {
      translation 0 0 0.53
      children [
        Shape {
          appearance USE EXHIBIT_FINISH
          geometry Box { size 0.1 0.12 1.06 }
        }
      ]
    }
  ]
}
# The card faces -X at zero yaw. Rotate CARD around world Z with [0, 0, 1, yaw].
# Camera is 1.5 m away; a yaw within +/-0.12 radians keeps the panel in view.
DEF CARD Pose {
  translation 0 0 1.3
  rotation 0 0 1 0
  children [
    Pose {
      translation 0.035 0 0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.03 0.12 0.15
              emissiveColor 0.01 0.06 0.075
            }
          }
          geometry Box { size 0.055 1.12 1.12 }
        }
      ]
    }
    Shape {
      appearance Appearance {
        material Material {
          ambientIntensity 0
          diffuseColor 0 0 0
          emissiveColor 1 1 1
        }
        texture DEF CARD_TEXTURE ImageTexture {
          url []
          repeatS FALSE
          repeatT FALSE
          filtering 0
        }
      }
      # Explicit UVs keep the photograph upright: image right is world -Y.
      geometry IndexedFaceSet {
        coord Coordinate {
          point [ 0 0.52 -0.52, 0 -0.52 -0.52, 0 -0.52 0.52, 0 0.52 0.52 ]
        }
        texCoord TextureCoordinate {
          point [ 0 0, 1 0, 1 1, 0 1 ]
        }
        coordIndex [ 0 1 2 3 -1 ]
        texCoordIndex [ 0 1 2 3 -1 ]
      }
    }
  ]
}
DEF CAMERA_RIG Robot {
  translation -1.5 0 1.3
  children [
    Camera {
      name "camera"
      fieldOfView 0.785398163
      width 256
      height 256
      near 0.01
      far 8
      exposure 1
      antiAliasing FALSE
      ambientOcclusionRadius 0
      bloomThreshold -1
      motionBlur 0
      noise 0
    }
    Pose {
      translation -0.12 0 0
      children [
        Shape {
          appearance Appearance {
            material Material { diffuseColor 0.12 0.5 0.6 }
          }
          geometry Box { size 0.2 0.22 0.16 }
        }
      ]
    }
    Pose {
      translation -0.12 0 -0.64
      children [
        Shape {
          appearance USE EXHIBIT_FINISH
          geometry Box { size 0.06 0.06 1.16 }
        }
      ]
    }
    Pose {
      translation -0.12 0 -1.27
      children [
        Shape {
          appearance USE EXHIBIT_FINISH
          geometry Box { size 0.42 0.42 0.06 }
        }
      ]
    }
  ]
  name "TEMMS camera rig"
  controller "temms_camera"
  supervisor TRUE
}
